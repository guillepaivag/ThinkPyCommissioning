SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
# OpenRouter is the default provider; OpenAI is also supported.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CLASSIFICATION_MODEL=openai/gpt-oss-120b
EXTRACTION_MODEL=openai/gpt-oss-120b
PROPOSAL_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b
FALLBACK_MODEL=qwen/qwen3.8-27b
EVALUATION_DELAY_SECONDS=45
FINDING_COOLDOWN_MINUTES=30
SQLITE_PATH=./data/commissioning.sqlite
PORT=8080
